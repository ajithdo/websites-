---
import MenuBrowser from '~/components/islands/menu/MenuBrowser';
import type { CategoryView, MenuConfig, MenuLabels } from '~/components/islands/menu/types';
import DietMark from '~/components/ui/DietMark.astro';
import { site } from '~/config/site';
import { getDictionary, langPaths, lt, makeFormatter, type Lang } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { responsiveImage } from '~/lib/images';
import { getMenu } from '~/lib/menu';
import { menuJsonLd } from '~/lib/seo';

export function getStaticPaths() {
  return langPaths();
}

const { lang } = Astro.props as { lang: Lang };
const t = getDictionary(lang);
const f = makeFormatter(lang);
const { categories } = await getMenu();

const views: CategoryView[] = await Promise.all(
  categories.map(async (c) => ({
    slug: c.slug,
    name: c.name,
    nameTe: c.nameTe,
    note: lang === 'te' && c.noteTe ? c.noteTe : c.note,
    items: await Promise.all(
      c.items.map(async (item) => ({
        id: item.id,
        name: item.name,
        nameTe: item.nameTe,
        description: lang === 'te' && item.descriptionTe ? item.descriptionTe : item.description,
        alt: item.alt,
        diet: item.diet,
        egglessAvailable: item.egglessAvailable,
        price: item.price,
        variants: item.variants,
        badges: item.badges,
        category: item.category,
        image: await responsiveImage(item.image, {
          widths: [120, 184, 256, 320],
          sizes: '(min-width: 64rem) 128px, 92px',
          aspect: 1,
          blur: false,
        }),
      })),
    ),
  })),
);

const labels: MenuLabels = {
  menu: t.menu,
  cart: t.cart,
  diet: t.diet,
  badges: t.badges,
  common: t.common,
};
const config: MenuConfig = {
  lang,
  brand: site.brand.name,
  whatsapp: site.contact.whatsapp,
  egglessSurcharge: site.menu.egglessSurcharge,
  timezone: site.timezone,
  areas: site.delivery.areas.map((a) => lt(a, 'en')),
  cartEnabled: site.features.enquiryCart,
};
---

<BaseLayout
  lang={lang}
  path="/menu/"
  title={f(t.menu.meta.title)}
  description={f(t.menu.meta.description)}
  jsonLd={[menuJsonLd(categories, Astro.site ?? new URL('http://localhost:4321'), lang)]}
>
  <header class="container-x menu-hero">
    <p class="eyebrow">{t.menu.eyebrow}</p>
    <h1 class="text-display-xl mt-4">{t.menu.title}</h1>
    <p class="lede mt-5">{site.features.enquiryCart ? t.menu.intro : f(t.menu.meta.description)}</p>
    <div class="menu-key">
      <span class="text-sm font-semibold text-ink-muted">{t.menu.dietKey}</span>
      <DietMark diet="veg" lang={lang} showLabel />
      <DietMark diet="egg" lang={lang} showLabel />
      <DietMark diet="nonveg" lang={lang} showLabel />
    </div>
  </header>

  <MenuBrowser client:load categories={views} labels={labels} config={config} />

  <p class="container-x menu-footnote">{f(t.menu.footnote)}</p>
</BaseLayout>

<style>
  .menu-hero {
    padding-top: clamp(1.75rem, 1.25rem + 3vw, 5.5rem);
    padding-bottom: clamp(1rem, 0.5rem + 2vw, 2rem);
  }
  /* Phones: the filter chips below show the same marks with labels. */
  @media (max-width: 47.99rem) {
    .menu-key {
      display: none !important;
    }
    .menu-hero h1 {
      font-size: calc(clamp(2.25rem, 1.6rem + 3.2vw, 3.5rem) * var(--bb-heading-scale));
    }
    .menu-hero .lede {
      font-size: 1rem;
    }
  }
  .menu-key {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-top: 1.75rem;
    font-size: 0.875rem;
  }
  .menu-footnote {
    padding-bottom: clamp(3rem, 2rem + 4vw, 6rem);
    font-size: 0.875rem;
    color: var(--bb-ink-muted);
  }
</style>

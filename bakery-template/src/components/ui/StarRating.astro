---
import { getDictionary, makeFormatter, type Lang } from '~/i18n';

interface Props {
  value: number;
  lang: Lang;
  size?: number;
}

const { value, lang, size = 16 } = Astro.props;
const f = makeFormatter(lang);
const t = getDictionary(lang);
---

<span class="inline-flex items-center gap-0.5" role="img" aria-label={f(t.a11y.rating, { value })}>
  {[1, 2, 3, 4, 5].map((n) => (
    <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true">
      <path
        d="M12 2.8l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 16.8l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"
        fill={n <= Math.round(value) ? 'var(--bb-accent)' : 'none'}
        stroke="var(--bb-accent)"
        stroke-width="1.4"
        stroke-linejoin="round"
      />
    </svg>
  ))}
</span>

---
/** Eyebrow + display title + optional lede, with an optional action slot. */
interface Props {
  eyebrow?: string;
  title: string;
  /** Italicised part of the title, rendered after `title`. */
  accent?: string;
  lede?: string;
  as?: 'h1' | 'h2';
  align?: 'start' | 'center';
  size?: 'lg' | 'md';
  id?: string;
  class?: string;
}

const {
  eyebrow,
  title,
  accent,
  lede,
  as: Tag = 'h2',
  align = 'start',
  size = 'lg',
  id,
  class: className,
} = Astro.props;
---

<div
  class:list={[
    'section-heading',
    align === 'center' && 'mx-auto text-center items-center',
    className,
  ]}
  data-reveal
>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag
    id={id}
    class:list={[
      size === 'lg' ? 'text-display-lg' : 'text-display-md',
      'mt-4 max-w-[18ch]',
      align === 'center' && 'mx-auto',
    ]}
  >
    {title}
    {accent && <em class="accent-word">{accent}</em>}
  </Tag>
  {lede && <p class:list={['lede mt-5', align === 'center' && 'mx-auto']}>{lede}</p>}
  <slot />
</div>

<style>
  .section-heading {
    display: flex;
    flex-direction: column;
  }
  .section-heading.items-center .eyebrow::before {
    display: none;
  }
  .accent-word {
    font-style: italic;
    color: var(--bb-accent-ink);
  }
</style>

---
/** Sticky thumb bar on phones: Call · WhatsApp · Directions. */
import Icon from '~/components/ui/Icon.astro';
import { site } from '~/config/site';
import { getDictionary, type Lang } from '~/i18n';
import { directionsHref, telHref, whatsappHref } from '~/lib/links';
import { openers } from '~/lib/whatsapp';

interface Props {
  lang: Lang;
}

const t = getDictionary(Astro.props.lang);
---

<nav class="action-bar" aria-label={t.a11y.quickActions} data-action-bar-nav>
  <a href={telHref} class="action-bar-item">
    <Icon name="phone" size={20} />
    <span>{t.cta.call}</span>
  </a>
  <a
    href={whatsappHref(openers.order(site.brand.name))}
    class="action-bar-item action-bar-primary"
    target="_blank"
    rel="noopener"
  >
    <Icon name="whatsapp" size={20} />
    <span>{t.cta.whatsapp}</span>
  </a>
  <a href={directionsHref} class="action-bar-item" target="_blank" rel="noopener">
    <Icon name="navigation" size={20} />
    <span>{t.cta.directions}</span>
  </a>
</nav>

<style>
  .action-bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 45;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    padding: 0.5rem max(0.75rem, env(safe-area-inset-left))
      calc(0.5rem + env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--bb-surface) 92%, transparent);
    backdrop-filter: saturate(1.3) blur(16px);
    border-top: 1px solid var(--bb-line);
    box-shadow: 0 -12px 30px -24px rgb(0 0 0 / 0.5);
  }
  .action-bar-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    min-height: 3.25rem;
    border-radius: var(--bb-radius-card);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--bb-ink);
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .action-bar-item:active {
    background: color-mix(in srgb, var(--bb-ink) 8%, transparent);
  }
  .action-bar-primary {
    background: var(--bb-accent);
    color: var(--bb-on-accent);
  }
  .action-bar-primary:active {
    background: color-mix(in srgb, var(--bb-accent) 85%, black);
  }
  @media (min-width: 48rem) {
    .action-bar {
      display: none;
    }
  }
</style>
